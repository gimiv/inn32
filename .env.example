# Resend (https://resend.com) API key used to send the group inquiry email.
# Required for the /api/group-inquiry route to deliver messages. Without it,
# the route returns a non-success response and the UI shows an honest error
# with phone/email fallback instead of a fake "Message Sent" confirmation.
RESEND_API_KEY=

# Mailbox that receives group inquiry submissions. Defaults to info@inn32.com
# if unset.
GROUP_INQUIRY_TO=info@inn32.com

# Verified sending address/domain in Resend, e.g. "Inn 32 <inquiries@inn32.com>".
# Required — the route treats a missing value the same as a missing API key.
GROUP_INQUIRY_FROM=
